{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",


  "TextFileLogger": {
    "FilePath": "Logs/app-log.txt",
    "MinimumLogLevel": "Information",
    "UseDailyRollingFiles": true
  },
  "RedisCacheOptions": {
    "Configuration": "localhost:6379",
    "InstanceName": "ModelBinding"
  }
}
